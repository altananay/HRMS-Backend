<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TRANSITIONAL: replaces PackageReference Microsoft.AspNetCore.Http 2.2.2 (an ASP.NET Core 2.2-era
    package that has no business in a net10.0 app). Application currently needs ASP.NET types because
    UploadCvFileCommand takes IFormFileCollection and SecuredOperation resolves IHttpContextAccessor.
    Phase 2 removes the aspect and Phase 3 moves file upload behind an abstraction; this
    FrameworkReference is deleted at that point.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="MediatR" />
    <!-- The Microsoft.Extensions.* packages that used to be listed here are provided by the
         Microsoft.AspNetCore.App shared framework above (NU1510). Once the FrameworkReference is
         dropped in Phase 3, Configuration/DependencyInjection/Logging Abstractions come back as
         explicit references. -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

  <!-- Transitional: all removed in Phase 2 (Castle) / Phase 3 (AutoMapper, MongoDB). -->
  <ItemGroup>
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" />
    <PackageReference Include="Castle.Core" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

</Project>
