<Project Sdk="Microsoft.NET.Sdk">

  <!--
    No FrameworkReference and no MongoDB.Driver any more.

    Microsoft.AspNetCore.App was a transitional reference needed because UploadCvFileCommand took an
    IFormFileCollection and SecuredOperation resolved IHttpContextAccessor. Both are gone: the
    aspect was deleted in Phase 2, and file upload now crosses the boundary as a plain
    FileUploadRequest defined in Application, with the ASP.NET binding staying in the controller.

    Application therefore knows nothing about ASP.NET, EF Core, Npgsql or any database driver — it
    depends only on Domain plus mediation, validation and mapping libraries.
  -->
  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- IOptions<TokenOptions> in AuthManager — the abstractions package only, no hosting. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />

    <!-- Source generator: compile-time mapping, no runtime reflection, unmapped members are errors.
         Referenced without asset restrictions: Mapperly ships the [Mapper] attributes alongside the
         generator, so excluding compile assets makes the attributes themselves unresolvable. -->
    <PackageReference Include="Riok.Mapperly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

</Project>
