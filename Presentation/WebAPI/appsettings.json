{
  "//": [
    "COMMITTED AND SECRET-FREE. This file declares structure and safe defaults only.",
    "Secrets (TokenOptions:SecurityKey, Storage:Azure:ConnectionString, Seed:AdminPassword) are",
    "supplied by user-secrets in Development and environment variables in Production. Any value",
    "here can be overridden by an env var using the double-underscore form, e.g.",
    "ConnectionStrings__Postgres."
  ],

  "ConnectionStrings": {
    "Postgres": "",
    "MongoDb": ""
  },

  "TokenOptions": {
    "Issuer": "hrms-api",
    "Audience": "hrms-client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "SecurityKey": ""
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "https://hrmstez.netlify.app"
    ]
  },

  "Serilog": {
    "Seq": {
      "ServerUrl": ""
    }
  },

  "Storage": {
    "Provider": "Local",
    "Azure": {
      "ConnectionString": "",
      "ContainerName": "cv-files"
    },
    "Local": {
      "RootPath": "wwwroot/uploads"
    }
  },

  "IdentityVerification": {
    "//": "Mernis (KPS) SOAP national-ID check. 'Null' fails closed without calling the service.",
    "Provider": "Null"
  },

  "Seed": {
    "AdminEmail": "admin@hrms.local",
    "AdminPassword": ""
  },

  "AllowedHosts": "*"
}
