<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    MediatR is BRACKET-PINNED to exactly 12.5.0 — the last Apache-2.0 release.
    13.0.0+ is dual-licensed (RPL-1.5 / commercial) under Lucky Penny Software. The bracket makes an
    accidental roll to 13.x a NuGet error rather than a licensing surprise. Do not widen this range.
  -->
  <ItemGroup Label="CQRS">
    <PackageVersion Include="MediatR" Version="[12.5.0]" />
  </ItemGroup>

  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="11.12.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
    <!-- FluentValidation.AspNetCore is deprecated (auto-validation removed upstream). Deleted in Phase 2
         along with ValidationFilter and ValidationAspect, in favour of a single ValidationBehavior. -->
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Auth">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Must be >= what JwtBearer 10.0.10 pulls transitively (8.19.2) or restore fails NU1109. -->
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup Label="API docs">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup Label="External services">
    <!-- Cloudflare R2 over the S3 API. Also covers AWS S3 / MinIO / Spaces by changing ServiceUrl.
         Note R2 needs DisablePayloadSigning + DisableDefaultChecksumValidation on every request —
         see R2Storage. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101.4" />

    <!-- SMTP for password-reset mail. MIT, like everything else here. Chosen over
         System.Net.Mail.SmtpClient, which Microsoft marks obsolete and recommends against for new
         code. In development it points at the Mailpit container; there is no cloud mail provider. -->
    <PackageVersion Include="MailKit" Version="4.17.0" />

    <!-- Mernis (KPS) SOAP client. The family must move in lockstep; 6.0.0 is the highest version
         published for every member (Duplex and Security cap there). Legacy on .NET 10 but still
         supported, and the only way to reach the government identity service. -->
    <PackageVersion Include="System.ServiceModel.Duplex" Version="6.0.0" />
    <PackageVersion Include="System.ServiceModel.Federation" Version="6.0.0" />
    <PackageVersion Include="System.ServiceModel.Http" Version="6.0.0" />
    <PackageVersion Include="System.ServiceModel.NetTcp" Version="6.0.0" />
    <PackageVersion Include="System.ServiceModel.Security" Version="6.0.0" />
  </ItemGroup>

  <!--
    The transitional group that used to sit here is gone. It carried Autofac, Castle.Core,
    AutoMapper, MongoDB.Driver and Serilog.Sinks.MongoDB so the solution could reach a green build
    on net10.0 while still running on MongoDB, and every one of them was replaced: Autofac and
    Castle by the built-in container plus MediatR pipeline behaviors, AutoMapper by Riok.Mapperly,
    the driver and its log sink by EF Core/Npgsql and Seq. No project references any of them, so
    the declarations were orphaned — under central package management an unreferenced
    PackageVersion is inert, which is precisely why it can sit here unnoticed. Do not re-add one
    speculatively; declare a version when a csproj actually references it.
  -->

  <!--
    INCOMING — added in Phase 3 (EF Core / PostgreSQL) and Phase 2 (tests).
    Declared here now so the whole target dependency set is visible in one place.
  -->
  <ItemGroup Label="Incoming — EF Core / PostgreSQL">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.0" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
  </ItemGroup>

  <!--
    Transitive pins that close published advisories.

    None of these is referenced directly — they arrive through System.ServiceModel (the Mernis SOAP
    client) and the test tooling, at versions that carry known vulnerabilities. Because
    CentralPackageTransitivePinningEnabled is on, a PackageVersion here lifts the resolved version
    without any project needing a PackageReference.

    The CI workflow fails on the vulnerable-package scan, so this list is what keeps it green. If an
    entry becomes unnecessary because a direct dependency catches up, delete it: a stale pin silently
    holds a package back.

    (Note for future edits: an XML comment may not contain a double hyphen, so option flags cannot be
    written out literally here.)
  -->
  <ItemGroup Label="Security — transitive pins">
    <!-- High: GHSA-555c-2p6r-68mm, via System.ServiceModel.* 6.0.0 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.10" />

    <!-- Critical: GHSA-rxg9-xrhp-64gj, via the test tooling -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.10" />

    <!-- High + moderate: GHSA-5mfx-4wcx-rv27, GHSA-m5vv-6r4h-3vj9, GHSA-wvxc-855f-jvrv -->
    <PackageVersion Include="Azure.Identity" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="Incoming — tests">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.7.0" />
    <PackageVersion Include="Respawn" Version="6.2.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
  </ItemGroup>

</Project>
