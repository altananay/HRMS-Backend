<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Azure.Storage.Blobs is gone: Cloudflare R2 was chosen instead, and R2 speaks the S3 API, so
    AWSSDK.S3 covers it along with AWS S3, MinIO and DigitalOcean Spaces.

    The System.ServiceModel.* family stays for the generated Mernis SOAP client. It now has a real
    implementation behind IdentityVerification:Provider=Mernis — previously these five packages
    were referenced for a CheckPerson whose entire body was `return true`, so no identity was ever
    actually verified.
  -->
  <PropertyGroup>
    <!--
      CS0108 comes from Connected Services/MernisServiceReference/Reference.cs, which svcutil
      generates: its CloseAsync hides ClientBase<T>.CloseAsync without the `new` keyword. The file is
      regenerated tooling output, so fixing it by hand would be undone the next time the service
      reference is refreshed. Scoped to this project so the rest of the solution stays strict.
    -->
    <NoWarn>$(NoWarn);CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="System.ServiceModel.Duplex" />
    <PackageReference Include="System.ServiceModel.Federation" />
    <PackageReference Include="System.ServiceModel.Http" />
    <PackageReference Include="System.ServiceModel.NetTcp" />
    <PackageReference Include="System.ServiceModel.Security" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- ValidateDataAnnotations() for R2Options — it lives in the DataAnnotations package, not
         Microsoft.Extensions.Options itself. -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- IHostEnvironment, for LocalStorage's guard against writing inside the served web root. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <!-- PasswordHasher<T> only — the hashing primitives, not the EF stores or Identity UI. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Application\Application.csproj" />
  </ItemGroup>

</Project>
