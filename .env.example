# Copy to .env and fill in. .env is gitignored.
# Only needed for `docker compose --profile api up`; the host-side `dotnet run` loop reads
# appsettings.Development.json plus user-secrets instead.

POSTGRES_PASSWORD=hrms

# Must be at least 32 bytes. Generate one with:
#   dotnet user-secrets set "TokenOptions:SecurityKey" "$(openssl rand -base64 48)"
# or on Windows PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
TOKEN_SECURITY_KEY=

# Password for the seeded bootstrap admin account (Seed:AdminEmail in appsettings.json).
SEED_ADMIN_PASSWORD=
